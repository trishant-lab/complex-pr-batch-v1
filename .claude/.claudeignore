# ===========================================
# .claudeignore -- Files Claude Code should skip
# ===========================================

# ----- Sensitive config -----
config/
*.env.config
*.env.config.json
prod.env.config

# ----- Secrets & credentials -----
.env
.env.*
*.key
*.pem
*.p12
*.jks
*.keystore

# ----- Generated / build artifacts -----
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg
build/
dist/
wheels/
.Python

# ----- DB rendered migrations (generated at runtime) -----
db/_migrations/

# ----- Test / coverage artifacts -----
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.lcov

# ----- Virtual environments -----
.venv/
venv/
env/

# ----- IDE / editor -----
.idea/
.vscode/
*.iml
*.vsix
.history/

# ----- OS files -----
.DS_Store
Thumbs.db
*~
._*

# ----- Dependency caches -----
node_modules/
.npm
.ruff_cache/
.mypy_cache/
.pytype/

# ----- Large / binary files -----
*.jar
*.war
*.zip
*.tar.gz
*.rar
*.apk
*.hprof

# ----- Git merge artifacts -----
*.orig
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*

# ----- Generated specs (regenerated by pre-commit) -----
openapi.json

# ----- Cursor (not relevant to Claude Code) -----
.cursor/

# ----- Form render compiled output -----
form_render/node_modules/
