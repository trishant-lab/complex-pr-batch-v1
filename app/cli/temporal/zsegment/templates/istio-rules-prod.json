[
  {
    "match": [
      {
        "headers": {
          "stage": {
            "exact": "prod-grpc"
          }
        }
      }
    ],
    "name": "zsegment-grpc-prod",
    "route": [
      {
        "destination": {
          "host": "zsegment-api-prod-grpc.{{tenant}}.svc.cluster.local",
          "port": {
            "number": 6565
          }
        }
      }
    ]
  },
  {
    "match": [
      {
        "uri": {
          "regex": "^/api/v1/prod/.*"
        }
      }
    ],
    "name": "zsegment-api-prod",
    "route": [
      {
        "destination": {
          "host": "zsegment-api-prod.{{tenant}}.svc.cluster.local",
          "port": {
            "number": 8090
          }
        }
      }
    ]
  },
  {
    "match": [
      {
        "uri": {
          "exact": "/"
        }
      }
    ],
    "name": "redirect",
    "redirect": {
      "uri": "/sprint/"
    }
  },
  {
    "match": [
      {
        "uri": {
          "prefix": "/"
        }
      }
    ],
    "name": "zsegment-ui",
    "route": [
      {
        "destination": {
          "host": "varnish-svc.varnish.svc.cluster.local",
          "port": {
            "number": 80
          }
        }
      }
    ]
  }
]