[
  {
    "match": [
      {
        "headers": {
          "stage": {
            "exact": "grpc"
          }
        }
      }
    ],
    "name": "zsegment-grpc",
    "route": [
      {
        "destination": {
          "host": "zsegment-api-prod.<<tenant>>.svc.cluster.local",
          "port": {
            "number": 6565
          }
        }
      }
    ]
  },
  {
    "match": [
      {
        "uri": {
          "regex": "^/api/v1/prod/.*"
        }
      }
    ],
    "name": "zsegment-api",
    "route": [
      {
        "destination": {
          "host": "zsegment-api-prod.<<tenant>>.svc.cluster.local",
          "port": {
            "number": 8090
          }
        }
      }
    ]
  },
  {
    "match": [
      {
        "uri": {
          "exact": "/"
        }
      }
    ],
    "name": "redirect",
    "redirect": {
      "uri": "/sprint/"
    }
  }
]
