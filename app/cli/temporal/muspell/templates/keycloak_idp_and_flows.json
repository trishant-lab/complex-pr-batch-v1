{
  "identityProviders": [
      {
          "alias": "ehrsimulatorapp",
          "displayName": "EHR Simulator APP",
          "providerId": "oidc",
          "enabled": true,
          "updateProfileFirstLoginMode": "on",
          "trustEmail": true,
          "storeToken": true,
          "addReadTokenRoleOnCreate": true,
          "authenticateByDefault": false,
          "linkOnly": false,
          "hideOnLogin": true,
          "firstBrokerLoginFlowAlias": "Smart on Fhir Login existing users only",
          "config": {
              "validateSignature": "false",
              "acceptsPromptNoneForwardFromClient": "true",
              "tokenUrl": "http://muspell-archive.<<tenant>>.svc.cluster.local:8080/public/api/v1/epicintegration/epicToken",
              "clientId": "simulator",
              "uiLocales": "false",
              "isAccessTokenJWT": "false",
              "filteredByClaim": "false",
              "backchannelSupported": "false",
              "caseSensitiveOriginalUsername": "false",
              "disableNonce": "false",
              "useJwksUrl": "true",
              "loginHint": "false",
              "sendClientIdOnLogout": "false",
              "pkceEnabled": "false",
              "clientAuthMethod": "client_secret_basic",
              "authorizationUrl": "http://muspell-archive.<<tenant>>.svc.cluster.local:8080/public/api/v1/epicintegration/epicToken",
              "disableUserInfo": "true",
              "sendIdTokenOnLogout": "true",
              "syncMode": "FORCE",
              "clientSecret": "PLACEHOLDER",
              "passMaxAge": "false",
              "allowedClockSkew": "0",
              "prompt": "none"
          }
      }
  ],
  "identityProviderMappers": [
      {
          "name": "ehr_app_name",
          "identityProviderAlias": "ehrsimulatorapp",
          "identityProviderMapper": "hardcoded-user-session-attribute-idp-mapper",
          "config": {
              "syncMode": "FORCE",
              "attribute.value": "Epic",
              "attribute": "ehr_app_name"
          }
      },
      {
          "name": "sub_to_username",
          "identityProviderAlias": "ehrsimulatorapp",
          "identityProviderMapper": "oidc-user-attribute-idp-mapper",
          "config": {
              "syncMode": "FORCE",
              "claim": "sub",
              "user.attribute": "username"
          }
      }
  ]
}