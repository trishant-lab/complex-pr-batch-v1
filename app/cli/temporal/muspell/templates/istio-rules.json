[
  {
      "name": "muspell-api",
      "route": [
          {
              "destination": {
                  "host": "muspell-archive.<<tenant>>.svc.cluster.local",
                  "port": {"number": 8080}
              },
              "headers": {
                  "response": {
                      "add": {
                          "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload"
                      }
                  }
              }
          }
      ],
      "match": [
          {"uri": {"regex": "^/api/v1/.*"}},
          {"uri": {"regex": "^/public/api/v1/.*"}}
      ],
      "retries": {"attempts": 2, "retryOn":  "reset"}
  },
  {
      "name": "muspell-log-collect",
      "route": [
          {
              "destination": {
                  "host": "grafana-agent.monitoring-system.svc.cluster.local",
                  "port": {"number": 12347}
              }
          }
      ],
      "match": [
          {"uri": {"prefix": "/logcollect"}}
      ],
      "rewrite": {"uri": "/collect"}
  },
  {
      "name": "muspell-analytics",
      "route": [
          {
              "destination": {
                  "host": "matomo-server.matomo.svc.cluster.local",
                  "port": {"number": 80}
              }
          }
      ],
      "match": [
          {"uri": {"prefix": "/analytics/"}}
      ],
      "rewrite": {"uri": "/"}
  }
]
