{
  "clientId": "muspell",
  "name": "Muspell Application Client",
  "description": "",
  "rootUrl": "https://<<tenant>>.<<domain>>",
  "adminUrl": "https://<<tenant>>.<<domain>>",
  "baseUrl": "https://<<tenant>>.<<domain>>",
  "surrogateAuthRequired": false,
  "enabled": true,
  "alwaysDisplayInConsole": false,
  "clientAuthenticatorType": "client-secret",
  "redirectUris": [
    "https://<<tenant>>.api.<<domain>>/*",
    "https://<<tenant>>.<<domain>>/*"
  ],
  "webOrigins": [
    "https://<<tenant>>.<<domain>>"
  ],
  "notBefore": 0,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": true,
  "directAccessGrantsEnabled": true,
  "serviceAccountsEnabled": false,
  "publicClient": true,
  "frontchannelLogout": false,
  "protocol": "openid-connect",
  "attributes": {
    "realm_client": "false",
    "oidc.ciba.grant.enabled": "false",
    "backchannel.logout.session.required": "true",
    "login_theme": "314e-login-theme",
    "oauth2.device.authorization.grant.enabled": "false",
    "display.on.consent.screen": "false",
    "backchannel.logout.revoke.offline.tokens": "false"
  },
  "authenticationFlowBindingOverrides": {},
  "fullScopeAllowed": true,
  "nodeReRegistrationTimeout": -1,
  "protocolMappers": [
    {
      "name": "docker-v2-allow-all-mapper",
      "protocol": "docker-v2",
      "protocolMapper": "docker-v2-allow-all-mapper",
      "consentRequired": false,
      "config": {}
    },
    {
      "name": "idp_name",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usersessionmodel-note-mapper",
      "consentRequired": false,
      "config": {
        "user.session.note": "identity_provider",
        "userinfo.token.claim": "true",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "claim.name": "idp_name",
        "jsonType.label": "String",
        "access.tokenResponse.claim": "false"
      }
    },
    {
      "name": "ehr_app_name",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usersessionmodel-note-mapper",
      "consentRequired": false,
      "config": {
        "user.session.note": "ehr_app_name",
        "userinfo.token.claim": "true",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "claim.name": "ehr_app_name",
        "jsonType.label": "String",
        "access.tokenResponse.claim": "false"
      }
    }
  ],
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "roles",
    "profile",
    "user_attribute",
    "basic",
    "email"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "organization",
    "offline_access",
    "microprofile-jwt"
  ]
}