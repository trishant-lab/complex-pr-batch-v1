{
  "tenant": {
    "allow_list": ["0.0.0.0/0", "::/0"],
    "db_host": "db-cluster-ha.postgres16.svc.cluster.local",
    "db_database": "<<DATABASE>>",
    "db_port": 5432,
    "enforce_ssl": false,
    "ip_version": "auto",
    "require_user": true,
    "users": [
      {
        "db_password": "<<DB_PASSWORD>>",
        "db_user": "<<DB_USER>>",
        "max_clients": 50,
        "mode_type": "transaction",
        "pool_checkout_timeout": 120,
        "pool_size": 40
      }
    ]
  }
}
